<!DOCTYPE html>
<html lang="fr">
<body style="margin:0;padding:0;background:#f5f7fa;font-family:Arial,Helvetica,sans-serif;color:#111418;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f7fa;padding:24px 12px;">
    <tr><td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#ffffff;border-radius:10px;overflow:hidden;">
            <tr><td style="height:6px;line-height:6px;font-size:0;background:linear-gradient(90deg,#2e7d4f 33%,#ffffff 33% 66%,#c8102e 66%);">&nbsp;</td></tr>
            <tr><td style="background:#c8102e;color:#ffffff;padding:20px 24px;font-size:20px;font-weight:bold;text-transform:uppercase;letter-spacing:.5px;">
                US Cormeilles Lieurey<br><span style="font-size:12px;letter-spacing:2px;opacity:.85;">Soirée dansante</span>
            </td></tr>
            <tr><td style="padding:24px;font-size:15px;line-height:1.5;">{% block content %}{% endblock %}</td></tr>
            <tr><td style="padding:16px 24px;background:#111418;color:#8b929c;font-size:12px;">{{ club.name }} · {{ club.email }}</td></tr>
        </table>
    </td></tr>
</table>
</body>
</html>
