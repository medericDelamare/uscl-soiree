{% extends 'base.html.twig' %}

{% block title %}Billet {{ booking.reference }}{% endblock %}

{% block body %}
    <div class="container section" style="max-width:640px">
        {% if not booking.paid %}
            <div class="verdict verdict--ko">✖ Billet non valable<small>Réservation {{ booking.reference }} : {{ booking.status.label|lower }}.</small></div>
        {% else %}
            {% set remaining = booking.guests|length - booking.checkedInCount %}
            {% if remaining == 0 %}
                <div class="verdict verdict--warn">Déjà entrés<small>Les {{ booking.guests|length }} personnes de cette réservation sont déjà entrées.</small></div>
            {% else %}
                <div class="verdict verdict--ok">✔ Billet valable<small>{{ remaining }} personne{{ remaining > 1 ? 's' }} à faire entrer sur {{ booking.guests|length }}.</small></div>
            {% endif %}
            <div class="card">
                <p><strong>{{ booking.fullName }}</strong> · {{ booking.reference }}<br><span class="muted">{{ booking.phone }}</span></p>
                {% for guest in booking.guests %}
                    <form class="entry {{ guest.checkedIn ? 'entry--done' }}" method="post" action="{{ path('control_checkin', {token: booking.accessToken}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('checkin' ~ booking.id) }}">
                        <input type="hidden" name="guest" value="{{ guest.id }}">
                        <span><strong>{{ guest.fullName }}</strong> · {{ guest.age }} ans<br><span class="muted">{{ guest.meal.label }}</span>{% if guest.comment %}<br><span class="note">⚠ {{ guest.comment }}</span>{% endif %}</span>
                        {% if guest.checkedIn %}
                            <span class="muted">Entré à {{ guest.checkedInAt|date('H\\hi', 'Europe/Paris') }}</span>
                            <button class="btn btn--ghost" name="undo" value="1">Annuler</button>
                        {% else %}
                            <button class="btn btn--primary">Valider l'entrée</button>
                        {% endif %}
                    </form>
                {% endfor %}
                {% if remaining > 1 %}
                    <form method="post" action="{{ path('control_checkin', {token: booking.accessToken}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('checkin' ~ booking.id) }}">
                        <input type="hidden" name="guest" value="all">
                        <button class="btn btn--primary btn--lg btn--block">Tout valider ({{ remaining }})</button>
                    </form>
                {% endif %}
            </div>
        {% endif %}
        <p><a href="{{ path('control_home') }}">← Chercher une autre réservation</a></p>
    </div>
{% endblock %}
